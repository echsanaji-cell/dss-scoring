{
  "name": "dss-taekwondo",
  "version": "1.0.0",
  "description": "Digital Scoring System Taekwondo",
  "main": "main.js",
  "scripts": {
    "test": "echo \"Error: no test specified\" && exit 1",
    "start": "electron .",
    "dist": "electron-builder --win",
    "dist:mac": "electron-builder --mac"
  },
  "keywords": [],
  "author": "Ozone",
  "license": "ISC",
  "type": "commonjs",
  "build": {
    "appId": "id.dss.taekwondo",
    "copyright": "DSS Taekwondo",
    "artifactName": "DSS-Taekwondo-${version}-${os}.${ext}",
    "productName": "DSS Taekwondo",
    "files": [
      "main.js",
      "operator.html",
      "scoreboard.html",
      "devtest.html",
      "style.css"
    ],
    "win": {
      "target": "nsis"
    },
    "mac": {
      "target": "dmg",
      "identity": null
    },
    "nsis": {
      "oneClick": false,
      "allowToChangeInstallationDirectory": true
    }
  },
  "devDependencies": {
    "electron": "^43.8.7",
    "electron-builder": "^26.18.0"
  },
  "dependencies": {
    "xlsx": "https://cdn.sheetjs.com/xlsx-0.20.3/xlsx-0.20.3.tgz"
  }
}
